VITE_BASE_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# MapTiler map-tile key (browser key, domain-restricted). Public by design — it
# must live in the tile URL — so a VITE_ prefix is correct here. Free, no credit
# card: sign up at https://maptiler.com and paste the key.
# Address search + routing use LocationIQ, whose key stays server-side only.
# The map degrades to a styled fallback when this is empty.
VITE_MAPTILER_KEY=
