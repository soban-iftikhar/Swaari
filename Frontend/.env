VITE_BASE_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Google Maps JavaScript API key (browser key — restrict by HTTP referrer in
# Google Cloud Console). Leave blank for local dev; the app falls back to a
# manual location entry + estimated fares when absent.
# For real secrets prefer .env.local (git-ignored).
VITE_GOOGLE_MAPS_API_KEY=
