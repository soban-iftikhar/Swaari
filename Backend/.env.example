# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-free single origin allowed to call the API / connect via Socket.io
CLIENT_ORIGIN=http://localhost:5173

# ─── Database ─────────────────────────────────────────────
# MongoDB connection string (MONGODB_URI is accepted as an alias)
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=Swaari

# ─── Auth (JWT) ───────────────────────────────────────────
# Generate strong random values, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=replace_with_a_long_random_string
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_string
ACCESS_TOKEN_TTL=24h
REFRESH_TOKEN_TTL=7d

# ─── Maps & Geolocation (optional) ────────────────────────
# LocationIQ server key — powers road-distance routing (Directions) and the
# /api/maps geocoding proxy (autocomplete + reverse). Free, no credit card:
# sign up at https://locationiq.com and paste the token here.
# Kept server-side only (no VITE_ prefix) so it never reaches the browser.
# The app degrades gracefully to haversine estimates when this is empty.
LOCATIONIQ_KEY=

# ─── Ride matching ────────────────────────────────────────
# Radius (km) used when searching for nearby online drivers.
DRIVER_SEARCH_RADIUS_KM=8
